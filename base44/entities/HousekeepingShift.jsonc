{
  "name": "HousekeepingShift",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string",
      "description": "FK to HousekeepingWorker"
    },
    "worker_name": {
      "type": "string",
      "description": "Snapshot of worker name at time of shift"
    },
    "date": {
      "type": "string",
      "description": "YYYY-MM-DD"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM \u2014 set when shift is closed"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED"
      ],
      "default": "OPEN"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Calculated when shift is closed"
    },
    "start_notes": {
      "type": "string"
    },
    "end_notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string",
      "description": "Email of admin who opened the shift"
    },
    "closed_by": {
      "type": "string",
      "description": "Email of admin who closed the shift"
    }
  },
  "required": [
    "worker_id",
    "worker_name",
    "date",
    "start_time",
    "status"
  ]
}