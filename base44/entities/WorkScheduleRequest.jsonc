{
  "name": "WorkScheduleRequest",
  "type": "object",
  "properties": {
    "worker_profile_id": {
      "type": "string",
      "description": "FK to WorkerProfile"
    },
    "worker_name": {
      "type": "string"
    },
    "internal_user_id": {
      "type": "string",
      "description": "FK to InternalUser"
    },
    "internal_user_email": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "DAY_OFF",
        "UNAVAILABLE",
        "PREFERRED_SHIFT",
        "SHIFT_CHANGE",
        "GENERAL_NOTE"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "related_shift_id": {
      "type": "string",
      "description": "Optional FK to WorkShift"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "CANCELLED"
      ],
      "default": "PENDING"
    },
    "admin_response": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "worker_profile_id",
    "request_type",
    "message",
    "status"
  ]
}