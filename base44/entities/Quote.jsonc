{
  "name": "Quote",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "FK to Group (required \u2014 Group is the prospect shell)"
    },
    "quote_number": {
      "type": "string",
      "description": "Human-readable reference e.g. Q-2026-047"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SENT",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "default": "DRAFT"
    },
    "quote_type": {
      "type": "string",
      "enum": [
        "lodging",
        "day_use",
        "custom"
      ],
      "default": "lodging",
      "description": "UI catalog type: lodging=\u05e7\u05d1\u05d5\u05e6\u05d4 \u05e2\u05dd \u05dc\u05d9\u05e0\u05d4, day_use=\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d9\u05d5\u05dd, custom=\u05de\u05d5\u05ea\u05d0\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea"
    },
    "client_name": {
      "type": "string",
      "description": "Contact/org name at quote time"
    },
    "contact_person": {
      "type": "string",
      "description": "Contact person name \u2014 shown in PDF as \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "client_phone": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_tax_id": {
      "type": "string",
      "description": "\u05d7.\u05e4 / \u05e2.\u05de \u2014 used in documents and guest form pre-fill"
    },
    "client_notes": {
      "type": "string",
      "description": "Client-visible notes \u2014 appear in the PDF. Do NOT use for internal notes."
    },
    "arrival_date": {
      "type": "string",
      "format": "date"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "arrival_time": {
      "type": "string",
      "description": "HH:MM \u2014 estimated arrival time on arrival day (optional)"
    },
    "departure_time": {
      "type": "string",
      "description": "HH:MM \u2014 estimated departure time on departure day (optional)"
    },
    "nights": {
      "type": "number",
      "description": "Calculated from date range, stored for pricing"
    },
    "estimated_pax": {
      "type": "number",
      "description": "Total headcount for pricing"
    },
    "staff_count": {
      "type": "number"
    },
    "participant_count": {
      "type": "number",
      "description": "Students / participants"
    },
    "includes_prisa": {
      "type": "boolean",
      "default": false,
      "description": "Whether \u05e4\u05e8\u05d9\u05e1\u05d4 (2.5 \u20aa per participant) is included in this quote"
    },
    "package_lines": {
      "type": "string",
      "description": "JSON array \u2014 new catalog packages: [{package_id, option_id, quantity, unit_price, shirley_addon, price_overridden, notes}]"
    },
    "new_addon_lines": {
      "type": "string",
      "description": "JSON array \u2014 new catalog addons: [{addon_id, quantity, unit_price, notes}]"
    },
    "student_lodging_lines": {
      "type": "string",
      "description": "JSON array (legacy): [{rate_type, pax, nights, rate, total}]"
    },
    "adult_lodging_lines": {
      "type": "string",
      "description": "JSON array (legacy): [{tent_type, tent_count, nights, rate_per_tent_per_night, total}]"
    },
    "workshop_lines": {
      "type": "string",
      "description": "JSON array (legacy): [{name, audience, rate, total}]"
    },
    "lecture_lines": {
      "type": "string",
      "description": "JSON array (legacy): [{name, lecturer, base_price, vat_included, vat_amount, total}]"
    },
    "coffee_corner_pax": {
      "type": "number",
      "description": "Number of people for Coffee Corner at \u20aa15/person"
    },
    "addon_lines": {
      "type": "string",
      "description": "JSON array (legacy): [{description, quantity, unit_price, total}]"
    },
    "adjustment_lines": {
      "type": "string",
      "description": "JSON array of custom flat adjustments: [{description, amount}] \u2014 positive=surcharge, negative=discount"
    },
    "surcharge_lines": {
      "type": "string",
      "description": "JSON array of free positive surcharges: [{description, amount}]"
    },
    "subtotal": {
      "type": "number"
    },
    "discount_percent": {
      "type": "number",
      "default": 0,
      "description": "Percentage discount applied to subtotal"
    },
    "discount_amount": {
      "type": "number",
      "description": "Computed: subtotal \u00d7 discount_percent / 100"
    },
    "total_price": {
      "type": "number",
      "description": "subtotal - discount_amount"
    },
    "advance_payment": {
      "type": "number",
      "description": "30% of total \u2014 computed"
    },
    "balance_payment": {
      "type": "number",
      "description": "70% of total \u2014 computed"
    },
    "payment_terms": {
      "type": "string"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal-only notes \u2014 NEVER appear in the client PDF"
    },
    "snapshot": {
      "type": "string",
      "description": "JSON snapshot captured only when status transitions to APPROVED"
    }
  },
  "required": [
    "group_id",
    "status",
    "version"
  ]
}