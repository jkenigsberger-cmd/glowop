{
  "name": "Quote",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "FK to Group (required \u2014 Group is the prospect shell)"
    },
    "quote_number": {
      "type": "string",
      "description": "Human-readable reference e.g. Q-2026-047"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SENT",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "default": "DRAFT"
    },
    "client_name": {
      "type": "string",
      "description": "Contact/org name at quote time"
    },
    "client_phone": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "arrival_date": {
      "type": "string",
      "format": "date",
      "description": "Commercial estimate, copied from Group"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_pax": {
      "type": "number",
      "description": "Total headcount for pricing purposes"
    },
    "staff_count": {
      "type": "number"
    },
    "participant_count": {
      "type": "number"
    },
    "lodging_lines": {
      "type": "string",
      "description": "JSON array: [{type, pax, nights, rate_per_person_per_night, total}]"
    },
    "activity_lines": {
      "type": "string",
      "description": "JSON array: [{name, pax, rate_per_person, fixed_price, total}]"
    },
    "catering_lines": {
      "type": "string",
      "description": "JSON array: [{type, pax, count, rate, notes, total}]"
    },
    "addon_lines": {
      "type": "string",
      "description": "JSON array: [{description, quantity, unit_price, total}]"
    },
    "subtotal": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "discount_reason": {
      "type": "string"
    },
    "total_price": {
      "type": "number"
    },
    "payment_terms": {
      "type": "string"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "internal_notes": {
      "type": "string"
    },
    "snapshot": {
      "type": "string",
      "description": "JSON snapshot captured only when status transitions to APPROVED"
    }
  },
  "required": [
    "group_id",
    "status",
    "version"
  ]
}