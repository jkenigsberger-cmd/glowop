{
  "name": "WorkerProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Worker display name"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Normalized contact email; does not grant system access"
    },
    "default_team": {
      "type": "string",
      "enum": [
        "OPERATIONS",
        "HOUSEKEEPING",
        "MAINTENANCE",
        "KITCHEN",
        "OTHER"
      ],
      "default": "OTHER"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "internal_user_id": {
      "type": "string",
      "description": "FK to InternalUser (optional \u2014 workers may exist without app login)"
    },
    "internal_user_email": {
      "type": "string",
      "description": "Normalized email of the confirmed linked InternalUser"
    },
    "notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "is_active"
  ]
}