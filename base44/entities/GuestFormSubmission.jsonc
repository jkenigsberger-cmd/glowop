{
  "name": "GuestFormSubmission",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "FK to Quote (primary link)"
    },
    "group_id": {
      "type": "string",
      "description": "FK to Group (operational reference)"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "client_org": {
      "type": "string",
      "description": "Organization / company name"
    },
    "group_type_label": {
      "type": "string",
      "description": "Free-text group classification e.g. \u05d1\u05d9\u05ea \u05e1\u05e4\u05e8, \u05ea\u05e0\u05d5\u05e2\u05ea \u05e0\u05d5\u05e2\u05e8"
    },
    "estimated_arrival_time": {
      "type": "string",
      "description": "HH:MM \u2014 estimated arrival time on arrival day"
    },
    "estimated_departure_time": {
      "type": "string",
      "description": "HH:MM \u2014 estimated departure time on departure day"
    },
    "total_pax": {
      "type": "number"
    },
    "staff_count": {
      "type": "number"
    },
    "participant_count": {
      "type": "number"
    },
    "boys_count": {
      "type": "number"
    },
    "girls_count": {
      "type": "number"
    },
    "staff_men_count": {
      "type": "number"
    },
    "staff_women_count": {
      "type": "number"
    },
    "drivers_men_count": {
      "type": "number"
    },
    "drivers_women_count": {
      "type": "number"
    },
    "is_sleeping_group": {
      "type": "boolean"
    },
    "arrival_lunch": {
      "type": "boolean"
    },
    "departure_lunch": {
      "type": "boolean"
    },
    "special_diets": {
      "type": "string",
      "description": "JSON: {vegetarian_count, vegan_count, glutenFree_count, lifeThreatening_count, nutFree_count, eggFree_count, lactoseFree_count, upgraded_coffee, coffee_corner_option, diet_notes}"
    },
    "meal_plan": {
      "type": "string",
      "description": "JSON array: [{date, meal_type, sandwich_instead}]"
    },
    "tent_distribution_notes": {
      "type": "string",
      "description": "JSON: {student_sleeping_notes, staff_sleeping_notes, drivers_lodging_notes}"
    },
    "schedule_notes": {
      "type": "string",
      "description": "JSON array: [{date, start_time, end_time, activity, location, pax, notes}]"
    },
    "general_notes": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "description": "ISO datetime"
    },
    "source": {
      "type": "string",
      "enum": [
        "LINK",
        "WHATSAPP",
        "MANUAL"
      ],
      "default": "MANUAL"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "SUBMITTED",
        "REVIEWED"
      ],
      "default": "PENDING"
    }
  },
  "required": [
    "quote_id",
    "group_id",
    "status"
  ]
}