{
  "name": "Group",
  "type": "object",
  "properties": {
    "group_name": {
      "type": "string",
      "description": "Group display name"
    },
    "group_type": {
      "type": "string",
      "enum": [
        "LODGING",
        "DAY_USE"
      ],
      "default": "LODGING"
    },
    "arrival_date": {
      "type": "string",
      "format": "date"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "arrival_time": {
      "type": "string",
      "description": "HH:MM \u2014 estimated arrival time on arrival day"
    },
    "departure_time": {
      "type": "string",
      "description": "HH:MM \u2014 estimated departure time on departure day"
    },
    "total_pax": {
      "type": "number"
    },
    "staff_count": {
      "type": "number"
    },
    "participant_count": {
      "type": "number"
    },
    "boys_count": {
      "type": "number"
    },
    "girls_count": {
      "type": "number"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CONFIRMED",
        "CANCELLED",
        "COMPLETED",
        "ARCHIVED"
      ],
      "default": "DRAFT"
    },
    "completed_at": {
      "type": "string",
      "description": "ISO datetime \u2014 set when group is marked COMPLETED"
    },
    "archived_at": {
      "type": "string",
      "description": "ISO datetime \u2014 set when group is frozen/archived"
    },
    "archived_reason": {
      "type": "string",
      "description": "Reason for freezing/archiving the group"
    }
  },
  "required": [
    "group_name",
    "group_type",
    "arrival_date",
    "status"
  ]
}