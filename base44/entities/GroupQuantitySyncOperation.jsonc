{
  "name": "GroupQuantitySyncOperation",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "FK to Group"
    },
    "idempotency_key": {
      "type": "string"
    },
    "request_fingerprint": {
      "type": "string"
    },
    "previous_quantities_json": {
      "type": "string"
    },
    "requested_quantities_json": {
      "type": "string"
    },
    "phases_json": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "PARTIAL",
        "COMPLETED",
        "FAILED"
      ]
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "idempotency_key",
    "request_fingerprint",
    "previous_quantities_json",
    "requested_quantities_json",
    "phases_json",
    "status"
  ]
}