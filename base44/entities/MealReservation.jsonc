{
  "name": "MealReservation",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "FK to Group"
    },
    "operational_group_profile_id": {
      "type": "string",
      "description": "FK to OperationalGroupProfile"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "meal_type": {
      "type": "string",
      "enum": [
        "BREAKFAST",
        "LUNCH",
        "DINNER",
        "COFFEE_CORNER",
        "OTHER"
      ]
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM \u2014 BREAKFAST +60min, LUNCH/DINNER +90min default"
    },
    "pax": {
      "type": "number"
    },
    "special_diets_summary": {
      "type": "string",
      "description": "JSON summary of diet counts for this meal"
    },
    "sandwich_option": {
      "type": "boolean",
      "default": false
    },
    "coffee_service_type": {
      "type": "string",
      "description": "For COFFEE_CORNER: e.g. \u05e7\u05e4\u05d4 \u05d5\u05e2\u05d5\u05d2\u05d9\u05d5\u05ea, \u05d0\u05d7\u05e8"
    },
    "activity_space_id": {
      "type": "string",
      "description": "FK to ActivitySpace \u2014 optional, for coffee corner location"
    },
    "source_activity_id": {
      "type": "string",
      "description": "FK to GroupScheduleItem \u2014 set when this coffee corner request was created from an activity. Used for idempotent upsert/cancel."
    },
    "coffee_locations_json": {
      "type": "string",
      "description": "JSON array of location names where coffee is needed (for split activities). e.g. [\"\u05d4\u05e8\u05d5\u05d7 \u05d4\u05e2\u05d1\u05e8\u05d9\u05ea\", \"\u05d4\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4\"]"
    },
    "activity_name": {
      "type": "string",
      "description": "Activity name \u2014 set when meal_type=COFFEE_CORNER and linked to an activity"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "groupSync",
        "manual",
        "guestForm"
      ],
      "description": "groupSync = prefilled from GuestForm; manual = added by admin; guestForm = submitted via external form"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CANCELLED"
      ],
      "default": "ACTIVE"
    }
  },
  "required": [
    "group_id",
    "operational_group_profile_id",
    "date",
    "meal_type",
    "start_time",
    "end_time",
    "pax",
    "source",
    "status"
  ]
}