{
  "name": "CalendarSync",
  "type": "object",
  "properties": {
    "group_schedule_item_id": {
      "type": "string",
      "description": "FK to GroupScheduleItem for group activities"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "GROUP_SCHEDULE_ITEM",
        "STANDALONE_ACTIVITY"
      ]
    },
    "source_id": {
      "type": "string",
      "description": "Canonical source id for additive calendar sources"
    },
    "calendar_event_id": {
      "type": "string",
      "description": "Google Calendar event ID"
    },
    "calendar_id": {
      "type": "string",
      "description": "Google Calendar ID"
    }
  },
  "required": [
    "calendar_event_id"
  ]
}