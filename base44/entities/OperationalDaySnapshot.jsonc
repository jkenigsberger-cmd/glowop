{
  "name": "OperationalDaySnapshot",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Asia/Jerusalem operational date; logical unique key"
    },
    "snapshot_json": {
      "type": "string",
      "description": "Immutable versioned Dashboard snapshot, first bounded chunk"
    },
    "snapshot_json_part_2": {
      "type": "string",
      "description": "Optional second bounded chunk of the immutable snapshot"
    },
    "snapshot_json_part_3": {
      "type": "string",
      "description": "Optional third bounded chunk of the immutable snapshot"
    },
    "snapshot_json_part_4": {
      "type": "string",
      "description": "Optional fourth bounded chunk of the immutable snapshot"
    },
    "finalized_at": {
      "type": "string",
      "description": "ISO datetime when the day was finalized"
    },
    "snapshot_version": {
      "type": "integer",
      "default": 1
    }
  },
  "required": [
    "date",
    "snapshot_json",
    "snapshot_version"
  ]
}