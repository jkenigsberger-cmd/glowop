{
  "name": "WorkShift",
  "type": "object",
  "properties": {
    "work_schedule_id": {
      "type": "string",
      "description": "FK to WorkSchedule"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "row_type": {
      "type": "string",
      "enum": [
        "PLANNED_ACTIVITY",
        "OPERATIONS_MORNING",
        "HOUSEKEEPING_MORNING",
        "HOUSEKEEPING_MANAGER",
        "MAINTENANCE",
        "OPERATIONS_EVENING",
        "HOUSEKEEPING_EVENING",
        "NIGHT_ON_CALL",
        "SPECIAL_TASKS"
      ]
    },
    "row_label": {
      "type": "string",
      "description": "Hebrew label snapshot e.g. \u05ea\u05e4\u05e2\u05d5\u05dc \u05d1\u05d5\u05e7\u05e8"
    },
    "row_order": {
      "type": "number",
      "description": "Visual order of the row in the grid"
    },
    "worker_id": {
      "type": "string",
      "description": "FK to WorkerProfile (optional \u2014 PLANNED_ACTIVITY and contractor cleaning rows have no worker)"
    },
    "worker_name": {
      "type": "string",
      "description": "Snapshot of worker name at assignment time"
    },
    "worker_count": {
      "type": "number",
      "description": "Number of contractor cleaners requested \u2014 required in UI for HOUSEKEEPING_MORNING and HOUSEKEEPING_EVENING"
    },
    "linked_source_shift_id": {
      "type": "string",
      "description": "Source WorkShift id when this shift was auto-created from another shift"
    },
    "auto_created_from": {
      "type": "string",
      "description": "Automation marker, e.g. OPERATIONS_EVENING_TO_NIGHT_ON_CALL"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "notes": {
      "type": "string"
    },
    "color_key": {
      "type": "string",
      "description": "Optional color override key"
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "CANCELLED"
      ],
      "default": "PLANNED"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "work_schedule_id",
    "date",
    "row_type",
    "status"
  ]
}