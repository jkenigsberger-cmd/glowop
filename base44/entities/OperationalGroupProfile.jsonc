{
  "name": "OperationalGroupProfile",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "FK to Group"
    },
    "quote_id": {
      "type": "string",
      "description": "FK to Quote"
    },
    "guest_form_submission_id": {
      "type": "string",
      "description": "FK to GuestFormSubmission"
    },
    "total_pax": {
      "type": "number"
    },
    "participant_count": {
      "type": "number"
    },
    "staff_count": {
      "type": "number"
    },
    "boys_count": {
      "type": "number"
    },
    "girls_count": {
      "type": "number"
    },
    "drivers_men_count": {
      "type": "number"
    },
    "drivers_women_count": {
      "type": "number"
    },
    "is_sleeping_group": {
      "type": "boolean"
    },
    "arrival_lunch": {
      "type": "boolean"
    },
    "departure_lunch": {
      "type": "boolean"
    },
    "special_diets": {
      "type": "string",
      "description": "JSON string"
    },
    "meal_plan": {
      "type": "string",
      "description": "JSON array"
    },
    "tent_distribution_notes": {
      "type": "string",
      "description": "JSON string"
    },
    "schedule_requests": {
      "type": "string",
      "description": "JSON array of schedule rows from GuestForm"
    },
    "general_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED"
      ],
      "default": "ACCEPTED"
    },
    "accepted_at": {
      "type": "string",
      "description": "ISO datetime"
    },
    "accepted_by": {
      "type": "string",
      "description": "Email of admin who accepted"
    },
    "boys_beds_needed": {
      "type": "number",
      "description": "Student beds required for boys"
    },
    "girls_beds_needed": {
      "type": "number",
      "description": "Student beds required for girls"
    },
    "estimated_student_tents_boys": {
      "type": "number",
      "description": "Estimated tent count for boys (planning only)"
    },
    "estimated_student_tents_girls": {
      "type": "number",
      "description": "Estimated tent count for girls (planning only)"
    },
    "staff_men_beds_needed": {
      "type": "number",
      "description": "VIP beds needed for male staff (kept for backward compat)"
    },
    "staff_women_beds_needed": {
      "type": "number",
      "description": "VIP beds needed for female staff (kept for backward compat)"
    },
    "vip_tents_men_needed": {
      "type": "number",
      "description": "Kept for backward compat"
    },
    "vip_tents_women_needed": {
      "type": "number",
      "description": "Kept for backward compat"
    },
    "student_sleeping_notes": {
      "type": "string"
    },
    "staff_sleeping_notes": {
      "type": "string"
    },
    "accessibility_sleeping_notes": {
      "type": "string"
    },
    "housekeeping_sleeping_notes": {
      "type": "string"
    },
    "sleeping_requirements_completed": {
      "type": "boolean",
      "default": false
    },
    "boys_tent_distribution_json": {
      "type": "string",
      "description": "JSON array [{tent_count, people_per_tent}] \u2014 planning only"
    },
    "girls_tent_distribution_json": {
      "type": "string",
      "description": "JSON array [{tent_count, people_per_tent}] \u2014 planning only"
    },
    "staff_men_tent_distribution_json": {
      "type": "string",
      "description": "Kept for backward compat"
    },
    "staff_women_tent_distribution_json": {
      "type": "string",
      "description": "Kept for backward compat"
    },
    "vip_tent_requirements_json": {
      "type": "string",
      "description": "JSON array [{gender_group, people_count, purpose, notes}] \u2014 one entry per required VIP tent"
    }
  },
  "required": [
    "group_id",
    "quote_id",
    "guest_form_submission_id",
    "status"
  ]
}